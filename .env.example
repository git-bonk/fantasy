# --- ESPN private league credentials ---
# League ID: from the league URL, e.g. https://fantasy.espn.com/.../home?leagueId=123456
ESPN_LEAGUE_ID=
# Cookies: DevTools -> Application -> Cookies -> fantasy.espn.com -> copy values
ESPN_S2=
SWID=

# Comma-separated seasons to ingest, e.g. 2023,2024,2025
SEASONS=2025

# Path to the SQLite database (relative to repo root unless absolute)
DB_PATH=data/fantasynfl.db
